# Copy to .env for local runs. Docker Compose reads the same values.
DATABASE_URL=postgresql+asyncpg://sitewarrant:sitewarrant@localhost:5432/sitewarrant
ARTIFACTS_DIR=artifacts
SITEWARRANT_VIEWPORT=1440x900
SITEWARRANT_PAGE_TIMEOUT_MS=30000
SITEWARRANT_MAX_PAGES=1
# Port 8080 is taken on the development host, so the fixture site listens on 8081.
FIXTURE_URL=http://localhost:8081
