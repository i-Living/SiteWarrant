# Copy to .env for local runs. Docker Compose reads the same values.
SITEWARRANT_DATABASE_URL=postgresql+asyncpg://sitewarrant:sitewarrant@localhost:5432/sitewarrant
ARTIFACTS_DIR=artifacts
# Fixed measurement viewports, mobile first. Comparison between agent versions needs
# identical conditions, so this is configuration, not a per-site decision.
SITEWARRANT_VIEWPORTS=390x844,768x1024,1440x900
SITEWARRANT_PAGE_TIMEOUT_MS=30000
SITEWARRANT_CAPTURE_TIMEOUT_MS=60000
SITEWARRANT_MAX_PAGES=1
# Comma-separated hosts whose private addresses may be requested. Empty by default:
# the local fixture site needs "localhost,127.0.0.1" to be auditable.
SITEWARRANT_ALLOW_PRIVATE_HOSTS=
# Agents. The provider is OpenCode Zen Go; the key is the same one the local agent
# harness uses. Without a key, --agents fails; without --agents nothing calls a model.
SITEWARRANT_LLM_BASE_URL=https://opencode.ai/zen/go/v1
SITEWARRANT_LLM_MODEL=deepseek-v4.1-flash
SITEWARRANT_LLM_API_KEY=
# Replay a recorded conversation instead of calling the provider (tests, offline runs).
SITEWARRANT_LLM_CASSETTE=
# Ceiling for the estimated model cost of one audit (empty disables it).
SITEWARRANT_AUDIT_COST_LIMIT_USD=0.25
# Port 8080 is taken on the development host, so the fixture site listens on 8081.
FIXTURE_URL=http://localhost:8081
